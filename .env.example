# ============================================================
# Kaushal Sankalp AI — Environment Variables
# ============================================================
# Copy to .env and fill in values. ALL features work without keys.
# Adding keys upgrades providers (browser -> Bhashini, rule-based -> Gemini).

# --- Database ---
# "postgres" or "sqlite" (default: sqlite — works without Docker)
DB_MODE=sqlite
# Only needed when DB_MODE=postgres
DATABASE_URL=postgresql+asyncpg://ks:ks_dev@localhost:5432/kaushal_sankalp

# --- LLM ---
# Leave blank for rule-based fallback (handles golden path)
GEMINI_API_KEY=

# --- Bhashini Speech ---
# Leave blank for browser Web Speech API fallback
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# --- Security ---
HASH_SALT=kaushal-sankalp-demo-salt-26241
JWT_SECRET=kaushal-sankalp-jwt-secret-dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Demo ---
DEMO_OTP=123456
SEED_ON_START=true
